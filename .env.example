# UNAV-SA local configuration (optional).
#
# Copy to `.env` and uncomment to override the defaults. All settings are also
# plain environment variables (prefix UNAV_). Defaults are project-relative:
# data/ under the repo root, server on 127.0.0.1:8765. See
# docs/LOCAL_CONFIGURATION.md.

# --- paths ---
# UNAV_DATA_DIR=./data                 # working data directory (DB, cache live here)
# UNAV_DB_PATH=./data/unav.db          # SQLite database path (defaults under DATA_DIR)
# UNAV_CACHE_DIR=./data/cache          # cache directory (defaults under DATA_DIR)
# UNAV_SAMPLES_DIR=./samples           # bundled sample catalogs

# --- query safety caps ---
# UNAV_QUERY_LIMIT=500                 # default max rows per regional fetch
# UNAV_MAX_RADIUS_DEG=5.0              # default max cone radius (deg) before refusing

# --- local server ---
# UNAV_SERVER_HOST=127.0.0.1           # bind address (keep localhost)
# UNAV_SERVER_PORT=8765                # port
